{
  "name": "hino-fleet-dashboard",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run copy:assets",
    "copy:assets": "mkdir -p dist && cp -R assets dist/assets",
    "start": "npm run build && STATIC_DIR=dist node server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  }
}
