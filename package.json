{
  "name": "hino-fleet-dashboard",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run copy:assets",
    "copy:assets": "node -e \"import { cpSync, mkdirSync } from 'fs'; mkdirSync('dist/assets',{recursive:true}); cpSync('assets/simulated-dvr','dist/assets/simulated-dvr',{recursive:true}); cpSync('excel-derived-data.js','dist/excel-derived-data.js');\"",
    "start": "npm run build && STATIC_DIR=dist node server.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  }
}
